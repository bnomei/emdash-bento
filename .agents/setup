#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
export CI=true
TIMEFORMAT='Completed in %3R seconds'

# The locked registry-verification dependency requires at least 22.22.2.
# /usr/local/bin also reaches new login shells without profile changes.
node_version=22.22.2
echo "Preparing Node.js $node_version"
if [[ "$(node --version 2>/dev/null || true)" != "v$node_version" ]]; then
  case "$(uname -m)" in
    x86_64) architecture=x64 ;;
    aarch64) architecture=arm64 ;;
    *) echo "Unsupported Node.js architecture" >&2; exit 1 ;;
  esac
  archive="node-v$node_version-linux-$architecture.tar.xz"
  download_dir="$(mktemp -d)"
  trap 'rm -rf "$download_dir"' EXIT
  time (
    cd "$download_dir"
    curl --fail --silent --show-error --location --retry 3 --max-time 120 \
      "https://nodejs.org/dist/v$node_version/$archive" -o "$archive"
    curl --fail --silent --show-error --location --retry 3 --max-time 120 \
      "https://nodejs.org/dist/v$node_version/SHASUMS256.txt" -o SHASUMS256.txt
    grep "  $archive\$" SHASUMS256.txt | sha256sum --check --status
    sudo tar -xJf "$archive" --directory /usr/local --strip-components=1
  )
fi
node --version
npm --version

echo 'Preparing locked npm dependencies'
# npm ci always reinstalls (15 seconds even warm). Keep its result in snapshots,
# invalidating it when setup, manifests, or the runtime changes.
dependency_key="$(
  { sha256sum package.json package-lock.json .agents/setup; node --version; npm --version; uname -sm; } |
    sha256sum | cut -d ' ' -f 1
)"
if [[ ! -f node_modules/.amp-dependencies ]] ||
  [[ "$(cat node_modules/.amp-dependencies)" != "$dependency_key" ]]; then
  time npm ci --include=dev --no-audit --no-fund
  printf '%s\n' "$dependency_key" > node_modules/.amp-dependencies
else
  echo 'Locked npm dependencies are already installed'
fi

echo 'Preparing Playwright Chromium and system libraries'
# Playwright's Debian 12 Chromium dependencies. Check dpkg before invoking apt,
# since --with-deps unconditionally updates apt even on a warm snapshot.
system_packages=(
  libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcairo2 libcups2
  libdbus-1-3 libdrm2 libgbm1 libglib2.0-0 libnspr4 libnss3 libpango-1.0-0
  libx11-6 libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3
  libxkbcommon0 libxrandr2 xvfb fonts-noto-color-emoji fonts-unifont
  libfontconfig1 libfreetype6 xfonts-scalable fonts-liberation
  fonts-ipafont-gothic fonts-wqy-zenhei fonts-tlwg-loma-otf fonts-freefont-ttf
)
missing_packages=()
for package in "${system_packages[@]}"; do
  if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != 'install ok installed' ]]; then
    missing_packages+=("$package")
  fi
done
if (( ${#missing_packages[@]} )); then
  time sudo apt-get update
  time sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing_packages[@]}"
fi
time npx --no-install playwright install chromium
